  characterName: Anna
  facePortrait: {fileID: 21300000, guid: 69ba6f4ad30e8154c9a9f2a384e40d5d, type: 3}
  npcDialog1: "\u0411\u043B\u044F! Who are you? Can't you see I'm vibing?"
  playerResponse1: Police. Miss, are you okay? I heard you possibly had tremors?
