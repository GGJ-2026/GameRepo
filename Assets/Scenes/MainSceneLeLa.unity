  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC
  characterName: Mina
  facePortrait: {fileID: 21300000, guid: 79d892724c6e2124296166ab2dec325b, type: 3}
  npcDialog1: Are you an officer of some kind?
  playerResponse1: Can I've a moment of your time? I'm worried about your friend.
  npcDialog2: It was horrible sir. She suddenly lost all control over her body. She's
    totally downplaying it.
  playerResponse2: ' Did she have any symptoms coming in? Any idea where she''s been?'
  npcDialog3: She was shivering like crazy. I asked her if she was cold. She coughed
    too y'know. I saw her talk to the guy behind the bar before I entered.
  playerResponse3: Thank you.
  waypoints: []
  waitTime: 3
  danceChance: 0.3
  socialRadius: 5
  audioSource: {fileID: 0}
  coughSound: {fileID: 0}
  currentStage: 0
  showDebugStatus: 1
