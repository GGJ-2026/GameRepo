  m_EditorClassIdentifier: Assembly-CSharp::NPC
  characterName: Evan
  facePortrait: {fileID: 21300000, guid: 73c5a7d0118684f4fa1612d65c41179f, type: 3}
  npcDialog1: Long time no see. What do you want?
  playerResponse1: Relax, I'm not here for you tonight. Who's been leaning in close
    this evening?
  npcDialog2: Royce has been cozying it up with the other bartender. Pretty sure
    the cop guy is jalouse. And I would say the two girls have been closing distance.
  playerResponse2: That all?
  npcDialog3: I came in late, but I'm pretty sure Royce always opens up the place.
  playerResponse3: Hmm.
  waypoints: []
  waitTime: 3
  danceChance: 0.3
